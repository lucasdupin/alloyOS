      },
      {
        "name": "days",
        "type": "number",
        "required": false,
        "description": "Forecast horizon in days (1 to 5)"
      }
    ]
  },
  {
    "name": "weather.set_location",
    "description": "Set the default city for weather queries",
    "params": [
      {
        "name": "city",
