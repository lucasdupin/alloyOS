        "type": "string",
        "required": false,
        "description": "City name (defaults to configured location)"
      },
      {
        "name": "units",
        "type": "string",
        "required": false,
        "description": "Temperature units ('celsius' or 'fahrenheit')"
      }
    ]
  },
  {
    "name": "weather.forecast",
    "description": "Fetch weather forecast for upcoming days",
    "params": [
      {
        "name": "city",
        "type": "string",
        "required": false,
