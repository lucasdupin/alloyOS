import { SoftKeyboard, AlloyPalette } from "@alloyos-keyboard/keyboard.slint";
import { VerticalBox, HorizontalBox, ScrollView, ListView } from "std-widgets.slint";
import "../../../assets/fonts/Quicksand-Medium.ttf";
import "../../../assets/fonts/Quicksand-Bold.ttf";
import { QuicksandGlyphCoverage } from "../../../assets/fonts/quicksand-coverage.slint";

// Alloy controls keep focus and selection silver on the embedded renderer.
component AlloyLineEdit inherits Rectangle {
    in property <string> placeholder-text;
    in property <bool> password: false;
    in property <string> field-label;
    in-out property <string> text;
    out property <bool> has-focus: editor.has-focus;
    out property <length> scroll-offset: -editor.x;
    forward-focus: editor;
    callback edited();
    callback accepted();
    height: 32px;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    background: transparent;
    Rectangle {
        y: parent.height - self.height;
        width: parent.width;
        height: 1px;
        background: editor.has-focus ? AlloyPalette.silver : AlloyPalette.border;
    }
    Text {
        x: 12px; y: 8px;
        width: parent.width - 24px; height: parent.height - 16px;
        text: root.placeholder-text;
        visible: root.text == "";
        color: AlloyPalette.muted;
        vertical-alignment: center;
    }
    viewport := Rectangle {
        x: 12px; y: 0px;
        width: parent.width - 24px; height: parent.height;
        clip: true;
        editor := TextInput {
            property <length> computed-x: 0px;
            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
            width: max(parent.width - self.text-cursor-width, self.preferred-width);
            height: parent.height;
            text <=> root.text;
            accessible-label: root.field-label != "" ? root.field-label : root.placeholder-text;
            color: AlloyPalette.text;
            selection-background-color: AlloyPalette.silver;
            selection-foreground-color: AlloyPalette.obsidian;
            single-line: true;
            input-type: root.password ? InputType.password : InputType.text;
            vertical-alignment: center;
            cursor-position-changed(position) => {
                if position.x + self.computed-x < 4px {
                    self.computed-x = -position.x + 4px;
                } else if position.x + self.computed-x > parent.width - 4px - self.text-cursor-width {
                    self.computed-x = parent.width - position.x - 4px - self.text-cursor-width;
                }
            }
            edited => { root.edited(); }
            accepted => { root.accepted(); }
        }
    }
}

component AlloyButton inherits FocusScope {
    in property <string> text;
    in property <string> button-label: root.text;
    in property <bool> flat: false;
    in property <image> icon;
    in property <bool> icon-only: false;
    callback clicked();
    height: 36px;
    vertical-stretch: 0;
    min-width: root.icon-only ? 32px : min(label.preferred-width + 24px, 100px);
    key-pressed(event) => {
        if (root.enabled && (event.text == " " || event.text == Key.Return)) {
            root.clicked();
            return accept;
        }
        return reject;
    }
    Rectangle {
        background: root.flat ? transparent : touch.pressed ? AlloyPalette.silver : touch.has-hover ? AlloyPalette.surface : AlloyPalette.charcoal;
        border-radius: 6px;
        border-width: root.flat ? 0px : 1px;
        border-color: root.has-focus ? AlloyPalette.silver : AlloyPalette.border;
        opacity: root.enabled ? 1 : 0.45;
        label := Text {
            visible: !root.icon-only;
            text: root.text;
            overflow: elide;
            color: root.flat ? (touch.pressed ? AlloyPalette.silver : AlloyPalette.text) : touch.pressed ? AlloyPalette.obsidian : AlloyPalette.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.icon-only: Image {
            source: root.icon;
            width: 18px;
            height: 18px;
            image-fit: contain;
            opacity: touch.pressed ? 0.7 : 1.0;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: root.button-label;
            clicked => { root.focus(); root.clicked(); }
        }
    }
}

export struct TileItemView {
    id: string, title: string, subtitle: string, badge: string, status: string,
}
export struct TileActionView { id: string, label: string }
export struct AvailableTileView { tile-id: string, title: string }
export struct TileView {
    tile-id: string, title: string, subtitle: string,
    image-source: string, image-alt: string,
    items: [TileItemView], actions: [TileActionView], refreshable: bool,
}
export global TileImages {
    in property <int> revision;
    pure callback resolve(string, int) -> image;
}

export struct MarkdownWordView { text: string, strong: bool, x: float, y: float, width: float, height: float }
export global MarkdownLayout {
    pure callback has-formatting(string) -> bool;
    pure callback refresh-words([MarkdownWordView], [MarkdownWordView], float) -> [MarkdownWordView];
    pure callback layout-words([MarkdownWordView], int, float, float, float) -> [MarkdownWordView];
}

export struct MarkdownBlockView {
    text: string, heading: int, code: bool, quote: bool, strong: bool, inline-bold: bool, words: [MarkdownWordView],
}

export struct ChatItemView {
    is-tile: bool,
    is-user: bool,
    text: string,
    blocks: [MarkdownBlockView],
    tile: TileView,
}

component InlineMarkdown inherits Rectangle {
    in property <[MarkdownWordView]> source;
    in property <bool> strong;
    in property <color> text-color;
    in property <length> font-size;
    property <[MarkdownWordView]> words: MarkdownLayout.layout-words(root.source, -1, 0, 0, root.width / 1px);
    out property <length> content-height: words.length > 0 ? (words[words.length - 1].y + words[words.length - 1].height) * 1px : root.font-size;
    height: root.content-height;
    for word[index] in root.words: Text {
        x: word.x * 1px; y: word.y * 1px;
        text: word.text;
        color: root.text-color;
        font-size: root.font-size;
        font-weight: root.strong || word.strong ? 700 : 500;
        font-family: root.strong || word.strong ? "Quicksand Bold" : "Quicksand";
        property <length> measured-width: measure.preferred-width - sentinel.preferred-width;
        property <length> measured-height: self.preferred-height;
        // A sentinel makes Slint include trailing spaces in the measured advance.
        measure := Text {
            visible: false;
            text: word.text + "M";
            font-size: root.font-size;
            font-weight: root.strong || word.strong ? 700 : 500;
        font-family: root.strong || word.strong ? "Quicksand Bold" : "Quicksand";
        }
        sentinel := Text {
            visible: false;
            text: "M";
            font-size: root.font-size;
            font-weight: root.strong || word.strong ? 700 : 500;
        font-family: root.strong || word.strong ? "Quicksand Bold" : "Quicksand";
        }
        init => { root.words = MarkdownLayout.layout-words(root.words, index, self.measured-width / 1px, self.measured-height / 1px, root.width / 1px); }
        changed measured-width => {
            if word.width != self.measured-width / 1px || word.height != self.measured-height / 1px {
                root.words = MarkdownLayout.layout-words(root.words, index, self.measured-width / 1px, self.measured-height / 1px, root.width / 1px);
            }
        }
        changed measured-height => {
            if word.height != self.measured-height / 1px {
                root.words = MarkdownLayout.layout-words(root.words, index, self.measured-width / 1px, self.measured-height / 1px, root.width / 1px);
            }
        }
    }
    changed source => { root.words = MarkdownLayout.refresh-words(root.source, root.words, root.width / 1px); }
    changed width => { root.words = MarkdownLayout.layout-words(root.words, -1, 0, 0, root.width / 1px); }
}

component MarkdownText inherits VerticalLayout {
    in property <length> body-size: 16px;
    in property <color> text-color: AlloyPalette.body;
    in property <string> text;
    in property <[MarkdownBlockView]> blocks;
    property <bool> formatted: MarkdownLayout.has-formatting(root.text);
    if !root.formatted: Text {
        text: root.text;
        font-size: root.body-size;
        color: root.text-color;
        wrap: word-wrap;
        horizontal-alignment: left;
        vertical-alignment: top;
    }
    if root.formatted: VerticalLayout {
    spacing: 4px;
    for block in root.blocks: Rectangle {
        min-height: block.inline-bold ? inline.content-height : label.preferred-height + (block.code ? 12px : 0px);
        background: block.code ? AlloyPalette.charcoal : transparent;
        border-radius: 4px;
        label := Text {
            visible: !block.inline-bold;
            x: block.code || block.quote ? 8px : 0px;
            y: block.code ? 6px : 0px;
            width: parent.width - self.x * 2;
            text: block.text;
            color: block.quote ? root.text-color.darker(15%) : root.text-color;
            font-size: root.body-size + (block.heading == 1 ? 8px : block.heading == 2 ? 5px : block.heading > 0 ? 2px : 0px);
            font-weight: block.heading > 0 || block.strong ? 700 : 500;
            font-family: block.heading > 0 || block.strong ? "Quicksand Bold" : "Quicksand";
            wrap: word-wrap;
        }
        inline := InlineMarkdown {
            visible: block.inline-bold;
            x: block.quote ? 8px : 0px;
            width: parent.width - self.x * 2;
            source: block.words;
            strong: block.heading > 0;
            text-color: block.quote ? root.text-color.darker(15%) : root.text-color;
            font-size: root.body-size + (block.heading == 1 ? 8px : block.heading == 2 ? 5px : block.heading > 0 ? 2px : 0px);
        }
    }
}
}

component TileCard inherits Rectangle {
    in property <bool> reorder-visible: false;
    in property <bool> reorder-enabled: false;
    min-width: 0px;
    clip: true;
    in property <TileView> tile;
    in property <bool> pinned;
    in property <bool> pending;
    callback action(string);
    callback pin();
    callback move();
    callback refresh();
    background: AlloyPalette.charcoal;
    border-radius: 12px;
    border-width: 1px;
    border-color: AlloyPalette.border;
    // Propagate the content size through the surrounding chat layouts so
    // cards cannot be compressed below their contents in the scroll stream.
    preferred-height: max(tile-content.preferred-height, tile-end.y + 6px);
    min-height: self.preferred-height;
    vertical-stretch: 0;
    tile-content := VerticalLayout {
        width: parent.width;
        height: self.preferred-height;
        padding: 16px;
        // The 10px gap before tile-end completes the bottom inset.
        padding-bottom: 6px;
        spacing: 10px;
        HorizontalBox {
            Text { text: root.tile.title; color: AlloyPalette.text; font-size: 20px; font-weight: 700; font-family: "Quicksand Bold"; wrap: word-wrap; horizontal-stretch: 1; min-width: 0px; }
            if root.reorder-visible: AlloyButton {
                text: "↑";
                flat: true;
                enabled: root.reorder-enabled && !root.pending;
                button-label: "Move " + root.tile.title + " to top";
                min-width: 32px;
                max-width: 32px;
                height: 32px;
                horizontal-stretch: 0;
                clicked => { root.move(); }
            }
            AlloyButton {
                flat: true;
                icon-only: true;
                icon: root.pinned ? @image-url("icons/pin-active.svg") : @image-url("icons/pin.svg");
                button-label: root.pinned ? "Unpin tile" : "Pin tile";
                min-width: 32px;
                max-width: 32px;
                height: 32px;
                horizontal-stretch: 0;
                clicked => { root.pin(); }
            }
        }
        if root.tile.subtitle != "": Text { text: root.tile.subtitle; color: AlloyPalette.muted; wrap: word-wrap; min-height: self.preferred-height; }
        if root.tile.image-source != "": tile-picture := Rectangle {
            property <image> picture: TileImages.resolve(root.tile.image-source, TileImages.revision);
            height: self.picture.width > 0 ? min(220px, self.width * self.picture.height / max(1, self.picture.width)) : 56px;
            vertical-stretch: 0;
            if tile-picture.picture.width > 0: Image {
                source: tile-picture.picture;
                width: parent.width;
                height: parent.height;
                image-fit: contain;
            }
            if tile-picture.picture.width == 0: Text {
                text: root.tile.image-alt != "" ? root.tile.image-alt : "Image unavailable";
                color: AlloyPalette.muted;
                wrap: word-wrap;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }
        for item in root.tile.items: VerticalLayout {
            min-height: self.preferred-height;
            vertical-stretch: 0;
            spacing: 4px;
            HorizontalLayout {
                min-height: self.preferred-height;
                vertical-stretch: 0;
                spacing: 8px;
                Text { text: item.title; color: AlloyPalette.text; font-size: root.tile.tile-id == "clock.now" && item.id == "time" ? 26px : 18px; wrap: word-wrap; min-width: 0px; horizontal-stretch: 1; min-height: self.preferred-height; }
                if item.badge != "": Text { text: item.badge; color: AlloyPalette.silver; horizontal-alignment: right; horizontal-stretch: 0; min-width: self.preferred-width; min-height: self.preferred-height; }
            }
            if item.subtitle != "": Text { text: item.subtitle; color: AlloyPalette.muted; wrap: word-wrap; min-height: self.preferred-height; }
            if item.status != "": Text { text: item.status; color: AlloyPalette.muted; font-size: 13px; wrap: word-wrap; min-height: self.preferred-height; }
        }
        if root.tile.actions.length > 0: VerticalLayout {
            min-height: self.preferred-height;
            vertical-stretch: 0;
            spacing: 8px;
            for action in root.tile.actions: AlloyButton {
                text: action.label;
                enabled: !root.pending;
                clicked => { root.action(action.id); }
            }
        }
        // Wrapped rows can exceed their preferred height at the final width.
        // Include their actual bottom edge in both inline and pinned card sizing.
        tile-end := Rectangle { height: 0px; }
    }
}

component WebViewCard inherits Rectangle {
    in property <string> origin;
    in property <string> title;
    in property <string> status;
    in property <bool> crashed: false;
    in property <image> frame;
    in property <bool> pending: false;
    callback expand();
    callback reload();
    min-width: 0px;
    clip: true;
    background: AlloyPalette.charcoal;
    border-radius: 12px;
    border-width: 1px;
    border-color: AlloyPalette.border;
    preferred-height: max(card-content.preferred-height, card-end.y + 6px);
    min-height: self.preferred-height;
    vertical-stretch: 0;
    card-content := VerticalLayout {
        width: parent.width;
        height: self.preferred-height;
        padding: 16px;
        padding-bottom: 6px;
        spacing: 10px;
        HorizontalBox {
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                spacing: 4px;
                Text {
                    text: root.title;
                    color: AlloyPalette.text;
                    font-size: 20px;
                    font-weight: 700;
                    font-family: "Quicksand Bold";
                    wrap: word-wrap;
                }
                Text {
                    text: root.origin;
                    color: root.crashed ? AlloyPalette.rust : AlloyPalette.muted;
                    font-size: 13px;
                    overflow: elide;
                }
            }
            AlloyButton {
                flat: true;
                icon-only: true;
                icon: @image-url("icons/reload.svg");
                enabled: !root.pending;
                button-label: "Reload webview";
                min-width: 32px;
                max-width: 32px;
                height: 32px;
                horizontal-stretch: 0;
                clicked => { root.reload(); }
            }
            AlloyButton {
                flat: true;
                icon-only: true;
                icon: @image-url("icons/expand.svg");
                enabled: !root.pending;
                button-label: "Expand webview";
                min-width: 32px;
                max-width: 32px;
                height: 32px;
                horizontal-stretch: 0;
                clicked => { root.expand(); }
            }
        }
        viewport := Rectangle {
            height: root.frame.width > 0 ? min(260px, self.width * root.frame.height / max(1, root.frame.width)) : 180px;
            vertical-stretch: 0;
            background: #101418;
            border-radius: 8px;
            border-width: 1px;
            border-color: AlloyPalette.border;
            clip: true;
            if root.frame.width > 0 && !root.crashed: Image {
                source: root.frame;
                width: parent.width;
                height: parent.height;
                image-fit: contain;
            }
            if root.crashed: Text {
                x: 16px;
                width: parent.width - 32px;
                height: parent.height;
                text: "Web content process terminated unexpectedly.";
                color: AlloyPalette.rust;
                vertical-alignment: center;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if root.frame.width == 0 && !root.crashed: Text {
                x: 16px;
                width: parent.width - 32px;
                height: parent.height;
                text: "Waiting for browser frame…";
                color: AlloyPalette.muted;
                vertical-alignment: center;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
        card-end := Rectangle { height: 0px; }
    }
}

component ExpandedWebView inherits Rectangle {
    in property <string> origin;
    in property <string> title;
    in property <string> status;
    in property <bool> crashed: false;
    in property <image> frame;
    callback collapse();
    callback reload();
    background: AlloyPalette.obsidian;
    TouchArea { width: parent.width; height: parent.height; }
    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 4px;
            vertical-stretch: 0;
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                spacing: 2px;
                Text {
                    text: root.title;
                    color: AlloyPalette.text;
                    font-size: 20px;
                    font-weight: 700;
                    font-family: "Quicksand Bold";
                    overflow: elide;
                }
                Text {
                    text: root.origin;
                    color: root.crashed ? AlloyPalette.rust : AlloyPalette.muted;
                    font-size: 13px;
                    overflow: elide;
                }
            }
            AlloyButton {
                flat: true;
                icon-only: true;
                icon: @image-url("icons/reload.svg");
                button-label: "Reload webview";
                min-width: 32px;
                max-width: 32px;
                height: 32px;
                horizontal-stretch: 0;
                clicked => { root.reload(); }
            }
            AlloyButton {
                flat: true;
                icon-only: true;
                icon: @image-url("icons/collapse.svg");
                button-label: "Collapse webview";
                min-width: 32px;
                max-width: 32px;
                height: 32px;
                horizontal-stretch: 0;
                clicked => { root.collapse(); }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            background: #101418;
            border-radius: 12px;
            border-width: 1px;
            border-color: AlloyPalette.border;
            clip: true;
            if root.frame.width > 0 && !root.crashed: Image {
                source: root.frame;
                width: parent.width;
                height: parent.height;
                image-fit: contain;
            }
            if root.crashed: Text {
                x: 24px;
                width: parent.width - 48px;
                height: parent.height;
                text: "Web content process terminated unexpectedly.";
                color: AlloyPalette.rust;
                vertical-alignment: center;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

component DrippingColumn inherits Rectangle {
    in property <int> time-ms: 0;
    in property <int> delay-ms: 0;
    width: 9px;
    height: 28px;

    // Match the boot liquid's slow growth, thinning neck and accelerating fall.
    property <int> t: mod(root.time-ms + 4200 - root.delay-ms, 4200);
    property <float> growth: min(root.t / 750.0, 1.0);
    property <float> falling: max((root.t - 750) / 1000.0, 0.0);
    property <float> release: min(root.falling / 0.22, 1.0);
    property <float> recovery: min(root.falling / 0.35, 1.0);
    property <length> droplet-w: 1.2px + 3px * root.growth;
    property <length> droplet-height: root.droplet-w * (1.4 - 0.25 * root.release);
    property <length> droplet-center-y: 6px + 5px * root.growth
        + 48px * root.falling * root.falling;
    property <float> droplet-opacity: clamp((1320 - root.t) / 250.0, 0.0, 1.0);
    property <length> anchor-w: 7px - 1px * root.growth * (1.0 - root.recovery);
    property <length> anchor-height: 7px + 1.5px * root.growth * (1.0 - root.recovery);

    // The neck thins as the drop gains mass, then breaks at release.
    if root.t < 750: Rectangle {
        width: 2.4px - 1.8px * root.growth;
        x: (parent.width - self.width) / 2;
        y: 6px;
        height: root.droplet-center-y - self.y;
        border-radius: self.width / 2;
        background: AlloyPalette.text;
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.droplet-center-y - self.height / 2;
        width: root.droplet-w;
        height: root.droplet-height;
        border-radius: self.width / 2;
        background: AlloyPalette.text;
        opacity: root.droplet-opacity;
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 2px;
        width: root.anchor-w;
        height: root.anchor-height;
        border-radius: self.width / 2;
        background: AlloyPalette.text;
    }
}

// Keep a departing card alive until its slide and the stack's reflow finish.
component PinnedTileRow inherits Rectangle {
    in property <bool> reorder-enabled;
    in property <TileView> tile;
    in property <bool> pinned;
    in property <bool> pending;
    in property <bool> reduced-motion;
    callback action(string);
    callback pin();
    callback move();
    callback refresh();
    callback finished();
    Timer {
        interval: 440ms;
        running: !root.pinned && !root.reduced-motion;
        triggered => { root.finished(); }
    }
    clip: true;
    height: root.pinned ? card.preferred-height + 12px : 0px;
    animate height {
        delay: root.reduced-motion || root.pinned ? 0ms : 200ms;
        duration: root.reduced-motion ? 0ms : 240ms;
        easing: ease-in-out;
    }
    card := TileCard {
        x: root.pinned ? 0px : -root.width;
        width: root.width;
        height: self.preferred-height;
        tile: root.tile;
        pinned: root.pinned;
        reorder-visible: true;
        reorder-enabled: root.reorder-enabled;
        pending: root.pending || !root.pinned;
        animate x { duration: root.reduced-motion ? 0ms : 200ms; easing: ease-in; }
        action(id) => { root.action(id); }
        pin => { root.pin(); }
        move => { root.move(); }
        refresh => { root.refresh(); }
    }
}

component ThinkingIndicator inherits Rectangle {
    in property <int> time-ms: 0;
    height: 30px;
    accessible-role: text;
    accessible-label: "Thinking";
    property <int> local-time-ms: 0;
    Timer {
        interval: 16ms;
        running: true;
        triggered => { root.local-time-ms = root.local-time-ms + 16; }
    }
    property <int> effective-time-ms: root.time-ms > 0 ? root.time-ms : root.local-time-ms;
    HorizontalBox {
        alignment: start;
        spacing: 8px;
        DrippingColumn { time-ms: root.effective-time-ms; delay-ms: 0; }
        DrippingColumn { time-ms: root.effective-time-ms; delay-ms: 1400; }
        DrippingColumn { time-ms: root.effective-time-ms; delay-ms: 2800; }
    }
}

component Logotype inherits Text {
    text: "alloyOS";
    font-size: 26px;
    font-weight: 700; font-family: "Quicksand Bold";
    color: AlloyPalette.text;
}

component ClientProfileForm inherits Rectangle {
    in property <string> request-id;
    changed request-id => { issuer.text = ""; client.text = ""; scopes.text = ""; port.text = ""; secret.text = ""; root.reviewing = false; root.offline = false; root.reprompt = false; }
    in property <string> app-name;
    in property <bool> busy;
    in property <string> endpoint;
    in property <string> error;
    changed error => { if root.error != "" { root.reviewing = false; } }
    callback submit(string, string, string, string, string, bool, bool);
    property <bool> offline: false;
    property <bool> reprompt: false;
    property <bool> google-issuer: issuer.text == "https://accounts.google.com";
    changed google-issuer => { if !root.google-issuer { root.offline = false; root.reprompt = false; } }
    callback cancel();
    out property <bool> has-focus: issuer.has-focus || client.has-focus || scopes.has-focus || port.has-focus || secret.has-focus;
    callback focus-changed(bool);
    changed has-focus => { root.focus-changed(root.has-focus); }
    property <bool> reviewing: false;
    background: AlloyPalette.obsidian;
    TouchArea { width: parent.width; height: parent.height; }
    VerticalBox {
        padding: 20px; spacing: 12px;
        Text { text: root.reviewing ? "Review client registration" : "Configure account client"; color: AlloyPalette.text; font-size: 22px; font-weight: 700; wrap: word-wrap; vertical-stretch: 0; }
        Text { text: root.app-name; color: AlloyPalette.text; wrap: word-wrap; vertical-stretch: 0; }
        form-scroll := ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            content-width: self.visible-width;
            mouse-drag-pan-enabled: true;
            VerticalBox {
                width: form-scroll.visible-width;
                padding: 0px; spacing: 10px;
                Text { text: "Resource: " + root.endpoint; color: AlloyPalette.muted; wrap: char-wrap; }
                Text { text: "Use registration details from your chosen service. Saving does not verify registration or connect an account."; color: AlloyPalette.muted; wrap: word-wrap; }
                Text { text: "Authorization issuer (HTTPS)"; color: AlloyPalette.text; }
                issuer := AlloyLineEdit { field-label: "Authorization issuer"; visible: !root.reviewing; placeholder-text: "https://…"; }
                if root.reviewing: Text { text: issuer.text; color: AlloyPalette.text; wrap: char-wrap; }
                Text { text: "Client ID"; color: AlloyPalette.text; }
                client := AlloyLineEdit { field-label: "Client ID"; visible: !root.reviewing; placeholder-text: "Registered native client ID"; }
                if root.reviewing: Text { text: client.text; color: AlloyPalette.text; wrap: char-wrap; }
                Text { text: "Allowed scopes (space separated)"; color: AlloyPalette.text; }
                scopes := AlloyLineEdit { field-label: "Allowed scopes"; visible: !root.reviewing; placeholder-text: "Service-approved scopes"; }
                if root.reviewing: Text { text: scopes.text; color: AlloyPalette.text; wrap: char-wrap; }
                Text { text: "Registered loopback port"; color: AlloyPalette.text; }
                port := AlloyLineEdit { field-label: "Registered loopback port"; visible: !root.reviewing; placeholder-text: "Registered port, or 0 for dynamic loopback"; }
                if root.reviewing: Text { text: port.text == "0" ? "Dynamic loopback port; path /oauth/callback" : "http://127.0.0.1:" + port.text + "/oauth/callback"; color: AlloyPalette.text; wrap: char-wrap; }
                Text { text: "Client secret (optional)"; color: AlloyPalette.text; }
                secret := AlloyLineEdit { field-label: "Optional client secret"; visible: !root.reviewing; password: true; placeholder-text: "Leave empty for a public PKCE client"; }
                if root.reviewing: Text { text: secret.text == "" ? "No client secret" : "Client secret provided (hidden)"; color: AlloyPalette.muted; }
                if root.google-issuer: AlloyButton {
                    enabled: !root.busy && !root.reviewing;
                    text: "Request Google offline access: " + (root.offline ? "Yes" : "No");
                    button-label: "Request Google offline access";
                    clicked => { root.offline = !root.offline; if !root.offline { root.reprompt = false; } }
                }
                if root.google-issuer: AlloyButton {
                    enabled: !root.busy && !root.reviewing && root.offline;
                    text: "Ask Google for consent again: " + (root.reprompt ? "Yes" : "No");
                    button-label: "Ask Google for consent again";
                    clicked => { root.reprompt = !root.reprompt; }
                }
                Text { text: "Private storage is unencrypted at rest. Changes remove any previous local account access."; color: AlloyPalette.muted; wrap: word-wrap; }
                if root.error != "": Text { text: root.error + " The secret field was cleared; re-enter it if required before reviewing again."; color: AlloyPalette.text; wrap: word-wrap; }
            }
        }
        HorizontalBox {
            vertical-stretch: 0; spacing: 12px;
            AlloyButton { enabled: !root.busy; text: "Cancel"; button-label: "Cancel client registration"; clicked => { secret.text = ""; root.cancel(); } }
            if root.reviewing: AlloyButton { enabled: !root.busy; text: "Edit"; button-label: "Edit client registration"; clicked => { root.reviewing = false; } }
            AlloyButton {
                text: root.reviewing ? "Save" : "Review";
                button-label: root.reviewing ? "Save private client registration" : "Review client registration";
                enabled: !root.busy && issuer.text != "" && client.text != "" && port.text != "";
                clicked => {
                    if root.reviewing {
                        root.submit(issuer.text, client.text, scopes.text, port.text, secret.text, root.offline, root.reprompt);
                        secret.text = "";
                    } else { root.reviewing = true; }
                }
            }
        }
    }
}

export component SystemUi inherits Window {
    title: "alloyOS · Ferrofluid";
    in property <bool> booting: false;
    background: root.booting ? #000000 : AlloyPalette.obsidian;
    default-font-family: "Quicksand";
    default-font-weight: 500;
    default-font-size: 16px;
    QuicksandGlyphCoverage {}
    in-out property <bool> sidebar-open: false;
    changed sidebar-open => { if !root.sidebar-open { root.available-tiles-expanded = false; } }
    in-out property <bool> sidebar-dragging: false;
    in-out property <length> sidebar-drag-reveal: 0px;
    in property <bool> sidebar-layer-visible: true;
    in property <image> sidebar-backdrop;
    out property <length> sidebar-width: min(340px, root.width - 48px);
    out property <length> sidebar-reveal: root.sidebar-dragging ? root.sidebar-drag-reveal : root.sidebar-open ? root.sidebar-width : 0px;
    animate sidebar-reveal { duration: root.sidebar-dragging ? 0ms : 260ms; easing: ease-out; }
    callback release-editor();
    release-editor => { unfocused.focus(); root.composer-active = false; }
    in property <string> active-model: "Gemini";
    in property <string> model-selection-status;
    in property <string> transcript: "";
    in-out property <string> draft;
    out property <length> composer-scroll-offset: input.scroll-offset;
    in property <bool> reply-pending: false;
    in property <int> loading-time-ms: 0;
    in property <[TileView]> tiles;
    in property <[MarkdownBlockView]> formatted-transcript;
    in property <[ChatItemView]> chat-items;
    in property <[TileView]> dashboard-tiles;
    in property <[AvailableTileView]> available-tiles;
    in-out property <bool> available-tiles-expanded: false;
    in property <bool> tile-catalog-loaded: false;
    in property <string> tile-catalog-error;
    callback discover-tiles();
    in property <string> client-profile-id;
    in property <string> client-profile-name;
    in property <string> client-profile-endpoint;
    in property <string> client-profile-error;
    in property <bool> client-profile-busy;
    property <bool> client-profile-focused: false;
    changed client-profile-id => { root.client-profile-focused = false; }
    callback client-profile-submit(string, string, string, string, string, bool, bool);
    callback client-profile-cancel();
    in property <string> pending-install-id;
    in property <bool> pending-install-removal;
    in property <string> pending-install-name;
    in property <string> pending-install-endpoint;
    in property <string> pending-install-source;
    in property <string> pending-install-publisher;
    property <bool> install-decision-sent: false;
    changed pending-install-id => { root.install-decision-sent = false; }
    callback remote-install-decision(string, bool);
    in property <bool> webview-visible: false;
    in-out property <bool> webview-expanded: false;
    in property <string> webview-origin;
    in property <string> webview-title;
    in property <string> webview-status;
    in property <bool> webview-crashed: false;
    in property <bool> webview-editable-focused: false;
    in property <image> webview-frame;
    callback webview-set-expanded(bool);
    callback webview-reload();
    in property <[TileView]> dashboard-pins;
    pure callback tile-is-pinned(string, [TileView]) -> bool;
    callback pin-tile(string, bool);
    callback finish-unpin(string);
    callback move-pin(string);
    callback refresh-tile(string);
    changed transcript => { scroll.content-y = min(0px, scroll.visible-height - scroll.content-height); }
    changed chat-items => { scroll.content-y = min(0px, scroll.visible-height - scroll.content-height); }
    changed webview-visible => { scroll.content-y = min(0px, scroll.visible-height - scroll.content-height); }
    changed reply-pending => {
        if root.reply-pending {
            scroll.content-y = min(0px, scroll.visible-height - scroll.content-height);
        }
    }
    callback tile-action(string, string);
    callback submit(string);
    callback cycle-model();
    callback soft-key(string);
    callback voice-toggle();
    callback voice-mute();
    callback output-mute-toggle();
    in property <bool> output-muted: false;
    in property <int> voice-state: 0;
    in property <float> voice-level: 0;
    property <bool> voice-active: root.voice-state >= 1 && root.voice-state <= 3;
    property <float> voice-merge: root.voice-active ? 1 : 0;
    animate voice-merge { duration: root.reduced-motion ? 0ms : 480ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    out property <float> wave-level: min(1, root.voice-level * 3);
    out property <float> wave-phase: root.reduced-motion ? 0 : root.loading-time-ms * 0.003333333;
    animate wave-level { duration: root.reduced-motion ? 0ms : 120ms; easing: linear; }
    in property <string> voice-caption;
    in property <string> voice-diagnostics;
    in property <string> voice-error;
    in property <bool> reduced-motion: false;
    property <bool> composer-active: false;
    property <float> animated-typing-progress: keyboard.shown ? 1 : 0;
    property <float> typing-progress: root.reduced-motion ? (keyboard.shown ? 1 : 0) : root.animated-typing-progress;
    animate animated-typing-progress { duration: root.reduced-motion ? 0ms : 420ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    changed keyboard-visible => { if root.keyboard-visible { root.voice-mute(); } }
    callback open-keyboard();
    open-keyboard => { root.composer-active = true; input.focus(); keyboard.reopen(); }
    out property <length> chat-top: body.y + chat.y;
    out property <length> bottom-fade-top: body.height - 80px * (1 - root.typing-progress);
    out property <length> bottom-fade-height: 80px * (1 - root.typing-progress);
    out property <length> scroll-offset: -scroll.content-y;
    out property <length> scroll-maximum: max(0px, scroll.content-height - scroll.visible-height);
    out property <length> chat-content-bottom: content-end.y + scroll.content-y;
    out property <length> pinned-content-height: pin-stream.height;
    out property <length> pinned-scroll-offset: -pin-scroll.content-y;
    out property <length> pinned-scroll-maximum: max(0px, pin-scroll.content-height - pin-scroll.visible-height);
    out property <length> chat-viewport-height: scroll.visible-height;
    out property <bool> keyboard-visible: keyboard.shown;
    out property <length> keyboard-reveal: keyboard.reveal;
    if root.booting: Logotype {
        color: #ffffff;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    frame := Rectangle {
        visible: !root.booting;
        clip: true;
        body := VerticalBox {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height - root.keyboard-reveal;
            padding: 0px;
            spacing: 0px;
            HorizontalBox {
                padding: 20px;
                Logotype { }
                Rectangle {
                    min-width: 0px;
                    min-height: 44px;
                    horizontal-stretch: 1;
                    model-label := Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.active-model;
                        color: AlloyPalette.muted;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    TouchArea {
                        width: parent.width;
                        height: parent.height;
                        enabled: !root.reply-pending;
                        mouse-cursor: pointer;
                        clicked => { root.cycle-model(); }
                    }
                }
            }
            if root.model-selection-status != "": Rectangle {
                height: status-label.preferred-height + 16px;
                status-label := Text {
                    x: 20px; y: 8px;
                    width: parent.width - 40px;
                    text: root.model-selection-status;
                    color: AlloyPalette.rust;
                    wrap: word-wrap;
                }
            }
            chat := Rectangle {
                width: parent.width;
                clip: true;
                min-height: 50px;
                vertical-stretch: 1;
                scroll := ScrollView {
                    width: parent.width;
                    height: parent.height;
                    mouse-drag-pan-enabled: true;
                    content-width: self.visible-width;
                    // Nested rows can lay out taller than their preferred size
                    // after wrapping at the available width. Measure the actual
                    // end of the stream so the final row remains reachable.
                    content-height: max(self.visible-height, content-end.y + 4px + (root.voice-state != 0 || root.voice-caption != "" ? 140px : 80px) * (1 - root.typing-progress));
                    // Layout changes after streamed text, tiles, or the indicator
                    // appear always reveal the latest content.
                    changed content-height => {
                        self.content-y = min(0px, self.visible-height - self.content-height);
                    }
                    changed visible-height => {
                        self.content-y = min(0px, self.visible-height - self.content-height);
                    }
                    horizontal-scrollbar-policy: always-off;
                    // Only user scrolling dismisses the keyboard. Programmatic
                    // scrolling during streaming or keyboard reveal keeps focus.
                    scrolled => {
                        keyboard.scroll-offset = -self.content-y;
                    }
                    stream := VerticalBox {
                        x: 0px;
                        y: 0px;
                        width: scroll.visible-width;
                        height: self.preferred-height;
                        padding-left: 20px;
                        padding-right: 20px;
                        padding-top: 16px;
                        // The 16px gap before content-end completes the 20px inset.
                        padding-bottom: 4px;
                        spacing: 16px;
                        if root.chat-items.length == 0: MarkdownText {
                            text: root.transcript;
                            blocks: root.formatted-transcript;
                        }
                        if root.chat-items.length == 0: VerticalBox {
                            padding: 0px;
                            spacing: 16px;
                            for tile in root.tiles: TileCard {
                                tile: tile; pending: root.reply-pending;
                                pinned: root.tile-is-pinned(tile.tile-id, root.dashboard-pins);
                                action(id) => { root.tile-action(tile.tile-id, id); }
                                pin => { root.pin-tile(tile.tile-id, !root.tile-is-pinned(tile.tile-id, root.dashboard-pins)); }
                                refresh => { root.refresh-tile(tile.tile-id); }
                            }
                        }
                        for item in root.chat-items: VerticalLayout {
                            if !item.is-tile: MarkdownText {
                                text: item.text;
                                blocks: item.blocks;
                                body-size: item.is-user ? 16px : 20px;
                                text-color: item.is-user ? AlloyPalette.muted : AlloyPalette.body;
                            }
                            if item.is-tile: TileCard {
                                tile: item.tile; pending: root.reply-pending;
                                pinned: root.tile-is-pinned(item.tile.tile-id, root.dashboard-pins);
                                action(id) => { root.tile-action(item.tile.tile-id, id); }
                                pin => { root.pin-tile(item.tile.tile-id, !root.tile-is-pinned(item.tile.tile-id, root.dashboard-pins)); }
                                refresh => { root.refresh-tile(item.tile.tile-id); }
                            }
                        }
                        if root.webview-visible: WebViewCard {
                            origin: root.webview-origin;
                            title: root.webview-title;
                            status: root.webview-status;
                            crashed: root.webview-crashed;
                            frame: root.webview-frame;
                            pending: root.reply-pending;
                            expand => {
                                root.release-editor();
                                root.sidebar-open = false;
                                root.webview-expanded = true;
                                root.webview-set-expanded(true);
                            }
                            reload => { root.webview-reload(); }
                        }
                        if root.voice-caption != "" && (root.voice-state == 2 || root.voice-state == 3 || root.voice-state == 4): Text {
                            text: root.voice-caption;
                            color: AlloyPalette.text;
                            wrap: word-wrap;
                        }
                        if root.reply-pending: ThinkingIndicator { time-ms: root.loading-time-ms; }
                        content-end := Rectangle { height: 0px; }
                    }
                }
            }

            composer := Rectangle {
                height: 72px * root.typing-progress;
                vertical-stretch: 0;
                input := AlloyLineEdit {
                    x: 20px;
                    // Keep the focused editor inside the window even before
                    // the composer's first animation frame reserves its height.
                    y: min(20px + 16px * (1 - root.typing-progress), parent.height - self.height);
                    width: parent.width - 40px;
                    visible: root.composer-active || root.typing-progress > 0;
                    opacity: root.typing-progress;
                    placeholder-text: "What would you like to do?";
                    text <=> root.draft;
                    edited => { keyboard.reopen(); }
                    accepted => { if (root.draft != "" && !root.reply-pending) { root.submit(root.draft); } }
                }
            }

        }
        // Begin the fade at the mic button and blend into the workspace.
        Rectangle {
            y: root.bottom-fade-top;
            width: parent.width;
            height: 80px * (1 - root.typing-progress);
            background: @linear-gradient(180deg, #0b0d1000 0%, AlloyPalette.obsidian 100%);
        }
        unfocused := FocusScope { width: 0px; height: 0px; }
        keyboard := SoftKeyboard {
            x: 4px;
            y: parent.height - root.keyboard-reveal;
            width: parent.width - 8px;
            requested: input.has-focus || root.client-profile-focused || (root.webview-visible && root.webview-editable-focused);
            reduced-motion: root.reduced-motion;
            suspended: root.booting || root.sidebar-reveal > 0px;
            key(value) => { root.soft-key(value); }
            dismiss => { root.release-editor(); }
        }
        // Cubic vector ribbons, driven by the smoothed microphone RMS envelope.
        // Their baseline is the display edge; lower lobes bleed beyond the viewport.
        Rectangle {
            x: 0px; y: parent.height - 70px; width: parent.width; height: 140px;
            visible: root.voice-active && !root.keyboard-visible;
            opacity: root.voice-merge;
            for layer in 3: Path {
                width: parent.width; height: parent.height;
                viewbox-width: 360; viewbox-height: 70;
                property <float> phase: root.wave-phase + layer * 1.7;
                property <float> amplitude: 2 + root.wave-level * (46 - layer * 7);
                property <float> crest: Math.sin(self.phase * 1rad) * self.amplitude;
                property <float> trough: Math.cos(self.phase * 1rad) * self.amplitude;
                fill: layer == 0 ? #b8b8ca35 : layer == 1 ? #9696b348 : #d2d2e248;
                // Keep the upper surface above the display edge even at zero RMS.
                // The lower return remains below the edge so the fill still bleeds out.
                property <float> surface: (root.voice-state == 2 ? 29 : 35) - root.wave-level * 8;
                MoveTo { x: 0; y: parent.surface; }
                CubicTo { control-1-x: 45; control-1-y: parent.surface; control-2-x: 50; control-2-y: parent.surface - parent.crest; x: 90; y: parent.surface - parent.crest; }
                CubicTo { control-1-x: 135; control-1-y: parent.surface - parent.crest; control-2-x: 135; control-2-y: parent.surface + parent.trough; x: 180; y: parent.surface + parent.trough; }
                CubicTo { control-1-x: 225; control-1-y: parent.surface + parent.trough; control-2-x: 230; control-2-y: parent.surface - parent.crest; x: 270; y: parent.surface - parent.crest; }
                CubicTo { control-1-x: 315; control-1-y: parent.surface - parent.crest; control-2-x: 315; control-2-y: parent.surface; x: 360; y: parent.surface; }
                CubicTo { control-1-x: 290; control-1-y: 35; control-2-x: 280; control-2-y: 39 + parent.trough; x: 240; y: 39 + parent.trough; }
                CubicTo { control-1-x: 180; control-1-y: 39 + parent.trough; control-2-x: 160; control-2-y: 39 - parent.crest; x: 120; y: 39 - parent.crest; }
                CubicTo { control-1-x: 65; control-1-y: 39 - parent.crest; control-2-x: 60; control-2-y: 35; x: 0; y: parent.surface; }
                Close {}
            }
        }
        toolbar := Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - 80px + 134px * root.typing-progress;
            width: 160px - 96px * root.voice-merge + 28px * root.typing-progress;
            height: 64px + 24px * root.typing-progress;
            visible: root.typing-progress < 1;
            opacity: 1 - root.typing-progress;
            background: transparent;
            Image { source: @image-url("icons/metaballs.svg"); width: parent.width; height: parent.height; image-fit: fill; visible: root.voice-merge == 0; }
            // The lobes converge continuously into one circle; the neck stays thin.
            Path {
                width: parent.width; height: parent.height;
                visible: root.voice-merge > 0 && root.voice-merge < 1;
                viewbox-width: 160 - 96 * root.voice-merge; viewbox-height: 64;
                fill: #29292b;
                MoveTo { x: 32; y: 0; }
                CubicTo { control-1-x: 52; control-1-y: 0; control-2-x: 56 - 48 * root.voice-merge; control-2-y: 27; x: 80 - 48 * root.voice-merge; y: 27; }
                CubicTo { control-1-x: 104 - 48 * root.voice-merge; control-1-y: 27; control-2-x: 108 - 96 * root.voice-merge; control-2-y: 0; x: 128 - 96 * root.voice-merge; y: 0; }
                CubicTo { control-1-x: 170.67 - 96 * root.voice-merge; control-1-y: 0; control-2-x: 170.67 - 96 * root.voice-merge; control-2-y: 64; x: 128 - 96 * root.voice-merge; y: 64; }
                CubicTo { control-1-x: 108 - 96 * root.voice-merge; control-1-y: 64; control-2-x: 104 - 48 * root.voice-merge; control-2-y: 37; x: 80 - 48 * root.voice-merge; y: 37; }
                CubicTo { control-1-x: 56 - 48 * root.voice-merge; control-1-y: 37; control-2-x: 52; control-2-y: 64; x: 32; y: 64; }
                CubicTo { control-1-x: -10.67; control-1-y: 64; control-2-x: -10.67; control-2-y: 0; x: 32; y: 0; }
                Close {}
            }
            Rectangle {
                width: 64px; height: 64px; border-radius: 32px;
                x: (parent.width - self.width) / 2;
                background: #29292b; opacity: root.voice-merge;
            }
            for index in 2: Rectangle {
                x: index == 0 ? 0px : parent.width - self.width;
                width: 64px; height: 64px;
                background: transparent;
                opacity: index == 0 ? 1 : 1 - root.voice-merge;
                property <float> swell: touch.pressed ? 1.12 : 1;
                animate swell { duration: root.reduced-motion ? 0ms : 240ms; easing: ease-out; }
                Rectangle {
                    width: 62px * parent.swell; height: 62px * parent.swell;
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    border-radius: self.width / 2;
                    background: #29292b;
                    opacity: touch.pressed ? 1 : 0;
                }
                Rectangle {
                    width: 52px; height: 52px; x: 6px; y: 6px;
                    border-radius: 26px;
                    background: #5a5a60;
                    visible: index == 0 && root.voice-state == 2;
                    opacity: root.reduced-motion ? 0.35 : 0.25 + 0.18 * Math.sin(root.loading-time-ms / 700 * 1rad);
                }
                Image {
                    source: index == 0 ? @image-url("icons/mic.svg") : @image-url("icons/keyboard.svg");
                    width: 24px * parent.swell; height: 24px * parent.swell;
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    opacity: index == 0 && root.voice-state == 4 ? 0.45 : 1;
                }
                touch := TouchArea {
                    enabled: !root.keyboard-visible && (index == 0 || !root.voice-active);
                    accessible-role: button;
                    accessible-label: index == 0 ? (root.voice-state == 0 || root.voice-state == 5 ? "Start voice conversation" : root.voice-state == 4 ? "Resume voice conversation" : "Stop voice conversation") : "Open keyboard";
                    clicked => { if index == 0 { root.voice-toggle(); } else { root.open-keyboard(); } }
                }
            }
        }
        Rectangle {
            x: toolbar.x + toolbar.width + 8px + 16px * (1 - root.voice-merge);
            y: toolbar.y;
            width: 56px; height: 64px;
            visible: root.voice-merge > 0 && root.typing-progress < 1;
            opacity: root.voice-merge * (1 - root.typing-progress);
            background: transparent;
            Rectangle {
                y: 6px; width: 52px; height: 52px; border-radius: 26px;
                background: transparent;
                Image {
                    source: root.output-muted ? @image-url("icons/speaker-muted.svg") : @image-url("icons/speaker.svg");
                    x: 14px; y: 14px; width: 24px; height: 24px;
                }
            }
            output-touch := TouchArea {
                enabled: root.voice-active && !root.keyboard-visible;
                accessible-role: button;
                accessible-label: root.output-muted ? "Unmute spoken replies" : "Mute spoken replies";
                clicked => { root.output-mute-toggle(); }
            }
        }
        Text {
            x: 20px; y: toolbar.y - self.height - 8px;
            width: parent.width - 40px; height: 32px;
            overflow: elide;
            vertical-alignment: center;
            visible: !root.keyboard-visible && (root.voice-state != 0 || root.voice-caption != "");
            text: root.voice-error != "" ? root.voice-error : root.voice-state == 1 ? (root.voice-caption != "" ? root.voice-caption : "Connecting…") : root.voice-state == 2 ? "Listening…" : root.voice-state == 3 ? "Responding…" : root.voice-state == 4 ? "Microphone muted" : "Voice unavailable";
            color: root.voice-state == 5 ? AlloyPalette.rust : AlloyPalette.muted;
            font-size: 13px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        // This layer is omitted while the host captures the pristine workspace.
        // Its image is a separately blurred backdrop; tiles are drawn afterwards.
        sidebar-layer := Rectangle {
            visible: root.sidebar-layer-visible && root.sidebar-reveal > 0px;
            width: parent.width;
            height: parent.height;
            Image {
                width: parent.width; height: parent.height;
                source: root.sidebar-backdrop;
                image-fit: fill;
                opacity: min(1, root.sidebar-reveal / root.sidebar-width);
            }
            Rectangle {
                width: parent.width; height: parent.height;
                // Fade the entire chat scene into the workspace background as
                // the blur grows; pinned content is painted after this layer.
                background: AlloyPalette.obsidian;
                opacity: 0.18 * root.sidebar-reveal / root.sidebar-width;
            }
            TouchArea {
                width: parent.width; height: parent.height;
                accessible-role: button;
                accessible-label: "Close pinned tiles";
                clicked => { root.sidebar-open = false; }
            }
            drawer := Rectangle {
                x: root.sidebar-reveal - root.sidebar-width;
                width: root.sidebar-width;
                height: parent.height;
                background: transparent;
                clip: true;
                // Consume blank-area taps rather than passing them to the scrim.
                TouchArea { width: parent.width; height: parent.height; }
                VerticalBox {
                    padding: 16px;
                    spacing: 16px;
                    HorizontalBox {
                        Text { text: "Pinned"; font-size: 24px; font-weight: 700; font-family: "Quicksand Bold"; color: AlloyPalette.text; vertical-alignment: center; horizontal-stretch: 1; }
                        AlloyButton { text: "×"; flat: true; button-label: "Close pinned tiles"; clicked => { root.sidebar-open = false; } }
                    }
                    pin-scroll := ScrollView {
                        vertical-stretch: 1;
                        mouse-drag-pan-enabled: true;
                        horizontal-scrollbar-policy: always-off;
                        content-width: self.visible-width;
                        content-height: max(self.visible-height, pin-stream.preferred-height);
                        pin-stream := VerticalBox {
                            width: pin-scroll.visible-width;
                            height: max(pin-scroll.visible-height, self.preferred-height);
                            padding: 0px;
                            padding-bottom: 16px;
                            spacing: 0px;
                            alignment: start;
                            if root.dashboard-tiles.length == 0: Text {
                                text: "Pin an available app tile below or add one from the conversation.";
                                color: AlloyPalette.muted;
                                wrap: word-wrap;
                                vertical-stretch: 0;
                            }
                            for tile[index] in root.dashboard-tiles: PinnedTileRow {
                                reorder-enabled: index > 0;
                                tile: tile; pending: root.reply-pending;
                                pinned: root.tile-is-pinned(tile.tile-id, root.dashboard-pins);
                                reduced-motion: root.reduced-motion;
                                action(id) => { root.tile-action(tile.tile-id, id); }
                                pin => { root.pin-tile(tile.tile-id, false); }
                                finished => { root.finish-unpin(tile.tile-id); }
                                move => { root.move-pin(tile.tile-id); }
                                refresh => { root.refresh-tile(tile.tile-id); }
                            }
                            VerticalBox {
                                vertical-stretch: 0;
                                padding: 0px;
                                padding-top: 20px;
                                spacing: 12px;
                                AlloyButton {
                                    text: (root.available-tiles-expanded ? "− " : "+ ") + "Available tiles" + (root.tile-catalog-loaded ? " (" + root.available-tiles.length + ")" : "");
                                    button-label: (root.available-tiles-expanded ? "Collapse" : "Expand") + " available tiles, " + root.available-tiles.length + " available";
                                    clicked => {
                                        root.available-tiles-expanded = !root.available-tiles-expanded;
                                        if root.available-tiles-expanded { root.discover-tiles(); }
                                    }
                                }
                                if root.available-tiles-expanded && root.tile-catalog-error != "": Text {
                                    text: root.tile-catalog-error; color: AlloyPalette.muted; wrap: word-wrap;
                                }
                                if root.available-tiles-expanded && !root.tile-catalog-loaded && root.tile-catalog-error == "": Text {
                                    text: "Loading available tiles…"; color: AlloyPalette.muted;
                                }
                                if root.available-tiles-expanded && root.tile-catalog-loaded && root.available-tiles.length == 0: Text {
                                    text: "No additional tiles available."; color: AlloyPalette.muted; wrap: word-wrap;
                                }
                                if root.available-tiles-expanded && root.available-tiles.length > 0: ListView {
                                  height: min(280px, root.available-tiles.length * 72px);
                                  vertical-stretch: 0;
                                  horizontal-scrollbar-policy: always-off;
                                  mouse-drag-pan-enabled: true;
                                  for tile in root.available-tiles: HorizontalBox {
                                    height: 72px;
                                    spacing: 10px;
                                    VerticalBox {
                                        padding: 0px;
                                        spacing: 3px;
                                        horizontal-stretch: 1;
                                        Text { text: tile.title; color: AlloyPalette.text; wrap: word-wrap; }
                                        Text { text: tile.tile-id; color: AlloyPalette.muted; font-size: 12px; wrap: word-wrap; }
                                    }
                                    AlloyButton {
                                        text: "+";
                                        button-label: "Pin " + tile.title;
                                        enabled: !root.reply-pending;
                                        clicked => { root.pin-tile(tile.tile-id, true); }
                                    }
                                  }
                                }
                            }
                        }
                    }
                }
            }
        }
        // Edge handle remains reachable independently of chat scroll position.
        Rectangle {
            visible: root.sidebar-layer-visible;
            x: max(0px, root.sidebar-reveal - 9px);
            y: (parent.height - 88px) / 2;
            width: 18px;
            height: 88px;
            background: transparent;
            Rectangle {
                x: root.sidebar-reveal > 0px ? 6px : 0px;
                width: 3px; height: parent.height;
                border-radius: 2px;
                background: AlloyPalette.silver;
                opacity: root.sidebar-reveal > 0px ? 0.8 : 0.45;
            }
            TouchArea {
                width: parent.width; height: parent.height;
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: root.sidebar-open ? "Close pinned tiles" : "Open pinned tiles";
                clicked => { root.release-editor(); root.sidebar-open = !root.sidebar-open; }
            }
        }
        if root.pending-install-id != "": Rectangle {
            width: parent.width; height: parent.height;
            background: #000000dd;
            // Approval is a native user action, separate from app/model tools.
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                width: min(parent.width - 32px, 520px);
                height: min(parent.height - 64px, 500px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: AlloyPalette.charcoal;
                border-color: AlloyPalette.silver; border-width: 1px; border-radius: 18px;
                VerticalBox {
                    padding: 20px; spacing: 16px;
                    Text { text: root.pending-install-removal ? "Remove app?" : "Install web-hosted MCP service?"; color: AlloyPalette.text; wrap: word-wrap; font-size: 22px; font-weight: 700; font-family: "Quicksand Bold"; vertical-stretch: 0; }
                    review-scroll := ScrollView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        content-width: self.visible-width;
                        mouse-drag-pan-enabled: true;
                        VerticalBox {
                            width: review-scroll.visible-width;
                            padding: 0px; spacing: 12px;
                            Text { text: root.pending-install-name; color: AlloyPalette.text; font-weight: 700; wrap: word-wrap; }
                            if root.pending-install-endpoint != "": Text { text: "Endpoint: " + root.pending-install-endpoint; color: AlloyPalette.text; wrap: char-wrap; }
                            Text { text: "Source: " + root.pending-install-source; color: AlloyPalette.muted; wrap: word-wrap; }
                            Text { text: "Publisher (unverified): " + (root.pending-install-publisher == "" ? "Not provided" : root.pending-install-publisher); color: AlloyPalette.muted; wrap: word-wrap; }
                            Text { text: root.pending-install-removal ? "Removal deletes this app package. It does not revoke access at the provider." : "Installation saves this connection. It does not connect an account or start OAuth."; color: AlloyPalette.muted; wrap: word-wrap; }
                        }
                    }
                    HorizontalBox {
                        spacing: 12px; vertical-stretch: 0;
                        AlloyButton {
                            text: "Cancel"; button-label: root.pending-install-removal ? "Cancel app removal" : "Cancel service installation";
                            enabled: !root.install-decision-sent;
                            clicked => { root.remote-install-decision(root.pending-install-id, false); root.install-decision-sent = true; }
                        }
                        AlloyButton {
                            text: root.install-decision-sent ? "Waiting…" : root.pending-install-removal ? "Remove" : "Install";
                            button-label: root.pending-install-removal ? "Remove app" : "Install web-hosted MCP service";
                            enabled: !root.install-decision-sent;
                            clicked => { root.remote-install-decision(root.pending-install-id, true); root.install-decision-sent = true; }
                        }
                    }
                }
            }
        }
        if root.client-profile-id != "": profile-form := ClientProfileForm {
            width: parent.width;
            height: parent.height - root.keyboard-reveal;
            request-id: root.client-profile-id;
            app-name: root.client-profile-name;
            busy: root.client-profile-busy;
            focus-changed(focused) => { root.client-profile-focused = focused; }
            endpoint: root.client-profile-endpoint;
            error: root.client-profile-error;
            submit(issuer, client, scopes, port, secret, offline, reprompt) => {
                root.release-editor();
                root.client-profile-submit(issuer, client, scopes, port, secret, offline, reprompt);
            }
            cancel => { root.release-editor(); root.client-profile-cancel(); }
        }
        if root.webview-visible && root.webview-expanded: ExpandedWebView {
            width: parent.width;
            height: parent.height - root.keyboard-reveal;
            origin: root.webview-origin;
            title: root.webview-title;
            status: root.webview-status;
            crashed: root.webview-crashed;
            frame: root.webview-frame;
            collapse => {
                root.release-editor();
                root.webview-expanded = false;
                root.webview-set-expanded(false);
            }
            reload => { root.webview-reload(); }
        }
    }
}
