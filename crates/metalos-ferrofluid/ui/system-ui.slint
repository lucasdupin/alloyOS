import { SoftKeyboard } from "@metalos-keyboard/keyboard.slint";
import { VerticalBox, HorizontalBox, ScrollView, LineEdit, Button } from "std-widgets.slint";
import "../../../assets/fonts/Quicksand.ttf";

export struct TileItemView {
    id: string, title: string, subtitle: string, badge: string, status: string,
}
export struct TileActionView { id: string, label: string }
export struct TileView {
    tile-id: string, title: string, subtitle: string,
    items: [TileItemView], actions: [TileActionView],
}

component ThinkingIndicator inherits Rectangle {
    height: 30px;
    accessible-role: text;
    accessible-label: "Thinking";
    property <int> phase: 0;
    Timer {
        interval: 260ms;
        running: true;
        triggered => { root.phase = mod(root.phase + 1, 3); }
    }
    HorizontalBox {
        alignment: start;
        spacing: 6px;
        for dot in 3: Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 4px;
            background: #bdbdff;
            opacity: root.phase == dot ? 1 : 0.3;
            animate opacity { duration: 220ms; }
        }
    }
}

component Logotype inherits Text {
    text: "metalOS";
    font-family: "Quicksand";
    font-size: 26px;
    font-weight: 700;
    color: #ffffff;
}

export component SystemUi inherits Window {
    title: "metalOS · Ferrofluid";
    in property <bool> booting: false;
    background: root.booting ? #000000 : #0a0a0c;
    default-font-family: "Quicksand";
    default-font-weight: 500;
    default-font-size: 16px;
    in property <string> active-model: "Gemini";
    in property <string> model-selection-status;
    in property <string> transcript: "Welcome to metalOS.\n\nYour workspace takes shape around what you need.";
    in-out property <string> draft;
    in property <bool> reply-pending: false;
    in property <[TileView]> tiles;
    changed transcript => { scroll.content-y = min(0px, scroll.visible-height - scroll.content-height); }
    changed tiles => { scroll.content-y = min(0px, scroll.visible-height - scroll.content-height); }
    callback tile-action(string, string);
    callback submit(string);
    callback cycle-model();
    callback soft-key(string);
    out property <length> chat-top: body.y + chat.y;
    out property <length> scroll-offset: -scroll.content-y;
    out property <length> scroll-maximum: max(0px, scroll.content-height - scroll.visible-height);
    out property <bool> keyboard-visible: keyboard.shown;
    out property <length> keyboard-reveal: keyboard.reveal;
    if root.booting: Logotype {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    frame := Rectangle {
        visible: !root.booting;
        clip: true;
        body := VerticalBox {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height - root.keyboard-reveal;
            padding: 0px;
            spacing: 0px;
            HorizontalBox {
                padding: 20px;
                Logotype { }
                Rectangle {
                    min-width: 0px;
                    min-height: 44px;
                    horizontal-stretch: 1;
                    model-label := Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.active-model;
                        color: #a0a0ae;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    TouchArea {
                        width: parent.width;
                        height: parent.height;
                        enabled: !root.reply-pending;
                        mouse-cursor: pointer;
                        clicked => { root.cycle-model(); }
                    }
                }
            }
            if root.model-selection-status != "": Text {
                text: root.model-selection-status;
                color: #a0a0ae;
                wrap: word-wrap;
            }
            chat := Rectangle {
                vertical-stretch: 1;
                VerticalBox {
                    padding: 0px;
                    Rectangle {
                        clip: true;
                        min-height: 50px;
                        vertical-stretch: 1;
                        scroll := ScrollView {
                            width: parent.width;
                            height: parent.height;
                            mouse-drag-pan-enabled: true;
                            content-width: self.visible-width;
                            content-height: max(self.visible-height, stream.preferred-height);
                            // Layout changes after streamed text, tiles, or the indicator
                            // appear always reveal the latest content.
                            changed content-height => {
                                self.content-y = min(0px, self.visible-height - self.content-height);
                            }
                            changed visible-height => {
                                self.content-y = min(0px, self.visible-height - self.content-height);
                            }
                            horizontal-scrollbar-policy: always-off;
                            // Only user scrolling dismisses the keyboard. Programmatic
                            // scrolling during streaming or keyboard reveal keeps focus.
                            scrolled => {
                                keyboard.scroll-offset = -self.content-y;
                            }
                            stream := VerticalBox {
                                x: 0px;
                                y: 0px;
                                width: scroll.visible-width;
                                height: self.preferred-height;
                                padding-left: 20px;
                                padding-right: 20px;
                                padding-top: 44px;
                                padding-bottom: 20px;
                                spacing: 16px;
                                transcript-text := Text {
                                    text: root.transcript;
                                    color: #d2d2dc;
                                    wrap: word-wrap;
                                    horizontal-alignment: left;
                                    vertical-alignment: top;
                                }
                                for tile in root.tiles: Rectangle {
                                    background: #20202a;
                                    border-radius: 12px;
                                    border-width: 1px;
                                    border-color: #404052;
                                    height: tile-content.preferred-height;
                                    tile-content := VerticalBox {
                                        width: parent.width;
                                        height: self.preferred-height;
                                        padding: 16px;
                                        spacing: 10px;
                                        Text { text: tile.title; color: #f0f0f4; font-size: 20px; font-weight: 700; wrap: word-wrap; }
                                        if tile.subtitle != "": Text { text: tile.subtitle; color: #a8a8ba; wrap: word-wrap; }
                                        for item in tile.items: VerticalBox {
                                            spacing: 4px;
                                            HorizontalBox {
                                                Text { text: item.title; color: #ffffff; font-size: tile.tile-id == "clock.now" && item.id == "time" ? 26px : 18px; wrap: word-wrap; }
                                                if item.badge != "": Text { text: item.badge; color: #bdbdff; horizontal-alignment: right; min-width: self.preferred-width; }
                                            }
                                            if item.subtitle != "": Text { text: item.subtitle; color: #a8a8ba; wrap: word-wrap; }
                                            if item.status != "": Text { text: item.status; color: #9292a8; font-size: 13px; wrap: word-wrap; }
                                        }
                                        if tile.actions.length > 0: HorizontalBox {
                                            spacing: 8px;
                                            for action in tile.actions: Button {
                                                text: action.label;
                                                enabled: !root.reply-pending;
                                                clicked => { root.tile-action(tile.tile-id, action.id); }
                                            }
                                        }
                                    }
                                }
                                if root.reply-pending: ThinkingIndicator { }
                            }
                        }
                    }
                }
            }
            HorizontalBox {
                padding: 20px;
                input := LineEdit {
                    placeholder-text: "What would you like to do?";
                    text <=> root.draft;
                    edited => { keyboard.reopen(); }
                    accepted => { if (root.draft != "" && !root.reply-pending) { root.submit(root.draft); } }
                }
            }
        }
        unfocused := FocusScope { width: 0px; height: 0px; }
        keyboard := SoftKeyboard {
            x: 4px;
            y: parent.height - root.keyboard-reveal;
            width: parent.width - 8px;
            requested: input.has-focus;
            suspended: root.booting;
            key(value) => { root.soft-key(value); }
            dismiss => { unfocused.focus(); }
        }
    }
}
