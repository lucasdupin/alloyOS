+}
+
+bool deleteNonEmptyDirectory(const String& path)
+{
+    for (auto& entry : listDirectory(path)) {
+        auto full = pathByAppendingComponent(path, entry);
+        if (fileType(full) == FileType::Directory)
+            deleteNonEmptyDirectory(full);
+        else
+            deleteFile(full);
+    }
+    return deleteEmptyDirectory(path);
+}
