+Vector<String> listDirectory(const String& path)
+{
+    Vector<String> entries;
+    DIR* dir = opendir(fileSystemRepresentation(path).data());
+    if (dir) {
+        while (auto* entry = readdir(dir)) {
+            if (strcmp(entry->d_name, ".") && strcmp(entry->d_name, ".."))
+                entries.append(String::fromUTF8(entry->d_name));
+        }
+        closedir(dir);
+    }
+    return entries;
+}
+
+void traverseDirectory(const String& path, NOESCAPE const Function<void(const String&, FileType)>& function)
+{
+    for (auto& entry : listDirectory(path)) {
+        auto full = pathByAppendingComponent(path, entry);
+        function(entry, fileType(full).value_or(FileType::Regular));
+    }
+}
+
+bool fileExists(const String& path)
+{
+    return access(fileSystemRepresentation(path).data(), F_OK) == 0;
+}
+
+bool deleteFile(const String& path)
+{
+    return unlink(fileSystemRepresentation(path).data()) == 0;
+}
+
+bool makeAllDirectories(const String& path)
+{
+    auto rep = fileSystemRepresentation(path);
+    if (rep.isNull() || !rep.length())
+        return false;
+    if (!access(rep.data(), F_OK))
+        return true;
+    return mkdir(rep.data(), 0755) == 0 || errno == EEXIST;
+}
+
+String pathByAppendingComponent(StringView path, StringView component)
+{
+    if (path.endsWith('/'))
+        return makeString(path, component);
+    return makeString(path, '/', component);
+}
+
+String pathByAppendingComponents(StringView path, std::span<const StringView> components)
+{
+    StringBuilder builder;
+    builder.append(path);
+    for (auto& c : components) {
+        if (!builder.isEmpty() && !builder.toString().endsWith('/'))
+            builder.append('/');
+        builder.append(c);
+    }
+    return builder.toString();
+}
