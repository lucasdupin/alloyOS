+
+bool copyFile(const String& targetPath, const String& sourcePath)
+{
+    auto srcRep = fileSystemRepresentation(sourcePath);
+    auto dstRep = fileSystemRepresentation(targetPath);
+    int srcFd = open(srcRep.data(), O_RDONLY);
+    if (srcFd < 0)
+        return false;
+    int dstFd = open(dstRep.data(), O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (dstFd < 0) {
+        close(srcFd);
+        return false;
+    }
+    char buf[4096];
+    ssize_t n;
+    bool ok = true;
+    while ((n = read(srcFd, buf, sizeof(buf))) > 0) {
+        if (write(dstFd, buf, n) != n) {
+            ok = false;
+            break;
+        }
+    }
+    if (n < 0)
+        ok = false;
+    close(srcFd);
+    close(dstFd);
+    return ok;
+}
+
+std::optional<uint64_t> hardLinkCount(const String& path)
+{
+    struct stat st;
+    if (!stat(fileSystemRepresentation(path).data(), &st))
